# Sao chép file này thành .env và điền thông tin
FB_EMAIL=your_email@example.com
FB_PASSWORD=your_password

# Năm cần dọn dẹp (mặc định: 2013)
TARGET_YEAR=2013

# Thời gian chờ giữa các thao tác (giây) - tăng nếu bị rate limit
DELAY_BETWEEN_ACTIONS=2

# Chạy headless (true) hay hiển thị trình duyệt (false)
HEADLESS=false
